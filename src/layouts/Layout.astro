---
import '../styles/global.css';
import '@fontsource/instrument-serif';
import '@fontsource/inter-tight';
import '@fontsource/jetbrains-mono';
import RecruiterToggle from '../components/RecruiterToggle.astro';
import NavigationRail from '../components/NavigationRail.astro';
import AmbientBackground from '../components/AmbientBackground.astro';
import XRayMode from '../components/XRayMode.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={"{{FULL_NAME}} - Cybersecurity Portfolio"} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <!-- Inline script to prevent FOUC on Recruiter Mode -->
    <script is:inline>
      const isRecruiter = localStorage.getItem('recruiterMode') === 'true';
      if (isRecruiter) {
        document.documentElement.dataset.mode = 'recruiter';
      } else {
        document.documentElement.dataset.mode = 'engineer';
      }
    </script>
  </head>
  <body class="bg-[var(--paper)] text-[var(--ink)] font-sans antialiased selection:bg-[var(--signal)] selection:text-[var(--paper)] min-h-screen relative">
    
    <XRayMode />
    <AmbientBackground />
    <RecruiterToggle />

    <!-- Engineer Mode Wrapper -->
    <div class="engineer-only">
      <div class="max-w-[1600px] mx-auto px-4 sm:px-8 lg:px-12">
        <div class="grid grid-cols-12 gap-4 md:gap-12 min-h-screen relative border-l border-r border-[var(--rule)] bg-[var(--paper)]/60">
          <!-- Left Rail -->
          <aside class="col-span-12 md:col-span-3 lg:col-span-2 border-b md:border-b-0 md:border-r border-[var(--rule)] bg-[var(--paper)]/80 backdrop-blur-sm relative z-20">
             <NavigationRail />
          </aside>

          <!-- Main Scroll Journey -->
          <main class="col-span-12 md:col-span-9 lg:col-span-10 flex flex-col min-h-screen relative z-10 px-4 md:px-0">
            <div class="flex-grow">
              <slot />
            </div>
            
            <!-- Footer Traceroute Delight -->
            <footer class="py-12 border-t border-[var(--rule)] text-[var(--ink)]/40 font-mono text-[10px] flex flex-col md:flex-row justify-between items-start md:items-center gap-8 mt-12 bg-[var(--paper)]/80 backdrop-blur-sm p-8">
              <div class="leading-relaxed">
                traceroute to <span class="text-[var(--ink)]">payload</span> (127.0.0.1), 30 hops max<br/>
                1  visitor-gateway (192.168.1.1)  0.2ms<br/>
                2  internet-exchange (10.0.0.1)  14.3ms<br/>
                3  decapsulate-edge (172.16.0.1)  22.1ms<br/>
                4  <span class="text-[var(--signal)]">payload-delivered</span> (127.0.0.1)  23.0ms
              </div>
              <div class="flex flex-col gap-3 md:items-end">
                <a href="/hardening" class="hover:text-[var(--signal)] underline decoration-[var(--rule)] underline-offset-4 transition-colors">/hardening case study</a>
                <a href="/.well-known/security.txt" class="hover:text-[var(--signal)] underline decoration-[var(--rule)] underline-offset-4 transition-colors">security.txt</a>
                <span class="mt-4 border border-[var(--rule)] px-2 py-1 bg-[var(--ink)]/5 inline-block text-[var(--ink)]">Press 'X' for architecture overlay</span>
              </div>
            </footer>
          </main>
        </div>
      </div>
    </div>

    <!-- Recruiter Mode Wrapper (F1 Summary View) -->
    <div class="recruiter-only min-h-screen flex flex-col items-center justify-center p-8 relative z-20">
      <div class="max-w-3xl w-full border border-[var(--rule)] p-12 bg-[var(--paper)] shadow-2xl relative mb-8">
         <h1 class="font-display text-4xl mb-4">{"{{FULL_NAME}}"}</h1>
         <p class="font-mono text-sm text-[var(--signal)] mb-8">Executive Summary & Case Files</p>
         <div class="border-t border-dashed border-[var(--rule)] pt-8 space-y-6">
            <p>Target Role: <strong>{"{{ROLE_1}}"}</strong></p>
            <div class="font-mono text-xs p-4 bg-[var(--ink)]/5 text-[var(--ink)] border border-[var(--rule)]">
              Toggle Recruiter Mode back off (top right) to view the full case files and decapsulation portfolio experience.
            </div>
         </div>
      </div>
      <div class="font-mono text-[10px] text-[var(--ink)]/40 flex gap-4">
        <a href="/hardening" class="hover:text-[var(--signal)] underline decoration-[var(--rule)]">View Site Hardening Specs</a>
      </div>
    </div>
  </body>
</html>
